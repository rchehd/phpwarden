{
  "name": "phpwarden/drupal11-sandbox",
  "type": "project",
  "repositories": [{"type": "composer", "url": "https://packages.drupal.org/8"}],
  "require": {
    "php": "^8.3",
    "composer/installers": "2.3.0",
    "drupal/core-recommended": "11.4.1",
    "drupal/core-composer-scaffold": "11.4.1",
    "drush/drush": "13.7.4"
  },
  "config": {
    "platform": {"php": "8.3.36"},
    "allow-plugins": {"composer/installers": true, "drupal/core-composer-scaffold": true, "symfony/runtime": true},
    "audit": {"block-insecure": false}
  },
  "extra": {
    "drupal-scaffold": {"locations": {"web-root": "web/"}},
    "installer-paths": {"web/core": ["type:drupal-core"]}
  }
}
