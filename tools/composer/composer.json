{
  "name": "phpwarden/composer-tools",
  "description": "Isolated Composer for PHPWarden validate and audit",
  "type": "project",
  "require": {
    "php": ">=8.4 <8.5",
    "composer/composer": "2.10.3",
    "symfony/console": "8.1.9",
    "symfony/filesystem": "8.1.9",
    "symfony/finder": "7.4.14",
    "symfony/polyfill-ctype": "1.37.0",
    "symfony/polyfill-mbstring": "1.43.0",
    "symfony/string": "8.1.9"
  },
  "config": {
    "allow-plugins": false,
    "platform": {"php": "8.4.26"},
    "sort-packages": true
  }
}
