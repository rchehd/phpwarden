{
  "name": "phpwarden/composer-tools",
  "description": "Isolated Composer for PHPWarden validate and audit",
  "type": "project",
  "require": {
    "php": ">=8.1 <8.5",
    "composer/composer": "2.10.3",
    "symfony/console": "6.4.48",
    "symfony/filesystem": "6.4.48",
    "symfony/finder": "6.4.47",
    "symfony/polyfill-ctype": "1.37.0",
    "symfony/polyfill-mbstring": "1.43.0",
    "symfony/string": "6.4.48"
  },
  "config": {
    "allow-plugins": false,
    "platform": {"php": "8.1.34"},
    "sort-packages": true
  }
}
