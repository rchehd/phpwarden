{
  "name": "phpwarden/phpstan-tools",
  "description": "Isolated PHPStan and Drupal extensions for PHPWarden",
  "type": "project",
  "require": {
    "php": ">=8.1 <8.5",
    "mglaman/phpstan-drupal": "2.2.2",
    "nette/neon": "3.4.9",
    "phpstan/phpstan": "2.3.1",
    "phpstan/phpstan-deprecation-rules": "2.0.5",
    "phpstan/phpstan-strict-rules": "2.1.0",
    "shipmonk/dead-code-detector": "1.4.2",
    "symfony/finder": "6.4.47",
    "symfony/yaml": "6.4.48"
  },
  "config": {
    "allow-plugins": false,
    "platform": {"php": "8.1.34"},
    "sort-packages": true
  }
}
