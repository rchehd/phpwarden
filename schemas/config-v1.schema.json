{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rchehd/phpwarden/schemas/config-v1.schema.json",
  "title": "PHPWarden project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "php"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "profile": {"type": "string", "enum": ["drupal"]},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "pattern": "^(auto|[0-9]+\\.[0-9]+\\.[0-9]+)$", "default": "auto"}
      }
    },
    "php": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "target"],
      "properties": {
        "runtime": {"$ref": "#/$defs/phpVersion"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"$ref": "#/$defs/phpVersion"},
            "max": {"$ref": "#/$defs/phpVersion"}
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["diff", "full"], "default": "diff"},
        "base": {"type": "string", "minLength": 1},
        "include": {"$ref": "#/$defs/include"},
        "exclude": {"$ref": "#/$defs/exclude"},
        "whole_files": {"type": "boolean", "default": false}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 300}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phpstan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "fail_on": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "never"
              ],
              "default": "error"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 120
            },
            "include": {
              "$ref": "#/$defs/include"
            },
            "exclude": {
              "$ref": "#/$defs/exclude"
            },
            "config": {
              "type": "string"
            },
            "discover_config": {
              "type": "boolean",
              "default": true
            },
            "extra_extensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\.[a-z][a-z0-9_]*$"
              }
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "includes": {
              "$ref": "#/$defs/exclude"
            },
            "baseline": {
              "type": "string"
            },
            "bootstrap_files": {
              "$ref": "#/$defs/exclude"
            },
            "scan_directories": {
              "$ref": "#/$defs/exclude"
            },
            "stub_files": {
              "$ref": "#/$defs/exclude"
            },
            "autoload": {
              "type": "string",
              "minLength": 1,
              "default": "auto"
            },
            "drupal": {
              "type": "boolean",
              "default": true
            },
            "deprecations": {
              "type": "boolean",
              "default": true
            },
            "memory_limit_mb": {
              "type": "integer",
              "minimum": 64,
              "maximum": 4096,
              "default": 512
            }
          }
        },
        "composer-validate": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "strict": {"type": "boolean", "default": false}
          }
        },
        "composer-audit": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": false},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "no_dev": {"type": "boolean", "default": false},
            "abandoned": {"type": "string", "enum": ["report", "ignore"], "default": "report"},
            "offline": {"type": "boolean", "default": false},
            "max_age_hours": {"type": "integer", "minimum": 0, "maximum": 8760, "default": 24},
            "max_stale_hours": {"type": "integer", "minimum": 0, "maximum": 8760, "default": 168},
            "ignore": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "reason"],
                "properties": {
                  "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
                  "reason": {"type": "string", "minLength": 1},
                  "until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
                }
              }
            }
          }
        },
        "twig-cs-fixer": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "config": {"type": "string", "minLength": 1},
            "discover_config": {"type": "boolean", "default": true},
            "extra_extensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z][a-z0-9_]*$"}},
            "extra_inputs": {"$ref": "#/$defs/exclude"}
          }
        },
        "phpcs": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "config": {"type": "string"},
            "discover_config": {"type": "boolean", "default": true},
            "standards": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}},
            "sniffs": {"$ref": "#/$defs/sniffs"},
            "exclude_sniffs": {"$ref": "#/$defs/sniffs"},
            "standard_paths": {"$ref": "#/$defs/exclude"},
            "extra_inputs": {"$ref": "#/$defs/exclude"},
            "extra_extensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z][a-z0-9_]*$"}},
            "error_severity": {"type": "integer", "minimum": 0, "maximum": 10, "default": 5},
            "warning_severity": {"type": "integer", "minimum": 0, "maximum": 10, "default": 5},
            "compatibility": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean", "default": false},
                "test_version": {"type": "string", "pattern": "^([1-9][0-9]*\\.(0|[1-9][0-9]*)(-[1-9][0-9]*\\.(0|[1-9][0-9]*))?)?$"}
              }
            }
          }
        },
        "drupal-config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "directories": {"$ref": "#/$defs/include", "default": ["config/install", "config/optional", "config/schema"]},
            "module_roots": {"$ref": "#/$defs/exclude", "default": []},
            "forbidden_keys": {
              "type": "array", "uniqueItems": true, "default": ["uuid", "_core"],
              "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"}
            }
          }
        },
        "whitespace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "trailing_whitespace": {"type": "boolean", "default": true},
            "conflict_markers": {"type": "boolean", "default": true},
            "trailing_whitespace_exclude": {"$ref": "#/$defs/exclude", "default": ["**/*.md", "**/*.patch", "**/*.diff"]},
            "conflict_markers_exclude": {"$ref": "#/$defs/exclude", "default": []}
          }
        },
        "yaml": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"}
          }
        },
        "syntax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "extra_extensions": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "pattern": "^\\.[a-z][a-z0-9_]*$"}
            }
          }
        },
        "debug": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "required": {"type": "boolean", "default": true},
            "fail_on": {"type": "string", "enum": ["error", "warning", "never"], "default": "error"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647, "default": 120},
            "include": {"$ref": "#/$defs/include"},
            "exclude": {"$ref": "#/$defs/exclude"},
            "functions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$"}
            },
            "js_functions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"}
            },
            "twig_functions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sniffs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*){1,3}$"}},
    "phpVersion": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)$"},
    "include": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
