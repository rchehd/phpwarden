            },
            "discover_config": {
              "type": "boolean",
              "default": true
            },
            "extra_extensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\.[a-z][a-z0-9_]*$"
              }
            },
            "extra_inputs": {
              "$ref": "#/$defs/exclude"
            }
          }
