{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rchehd/phpwarden/schemas/config-v1.schema.json",
  "title": "PHPWarden project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "php"
  ],
  "properties": {
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5, "default": 2},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 540, "default": 300}
          }
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 540, "default": 120},
        "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 8760, "default": 24},
        "max_stale_hours": {"type": "integer", "minimum": 1, "maximum": 8760, "default": 168},
        "offline": {"type": "boolean", "default": false}
      }
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string",
      "enum": [
        "drupal"
      ]
    },
    "composer_root": {
      "type": "string",
      "minLength": 1,
      "default": "."
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(auto|[0-9]+\\.[0-9]+\\.[0-9]+)$",
          "default": "auto"
        }
      }
    },
    "php": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "target"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/phpVersion"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/phpVersion"
            },
            "max": {
              "$ref": "#/$defs/phpVersion"
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "diff",
            "full"
          ],
          "default": "diff"
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "$ref": "#/$defs/include"
        },
        "exclude": {
          "$ref": "#/$defs/exclude"
        },
        "whole_files": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
		"image_pull": {"type": "string", "enum": ["missing", "never"], "default": "missing"},
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 1,
          "description": "Maximum concurrent analyzers; 1 runs sequentially, 0 runs all requested analyzers concurrently."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 300
        },
        "result_cache": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phpstan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "fail_on": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "never"
              ],
              "default": "error"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 120
            },
            "include": {
              "$ref": "#/$defs/include"
            },
            "exclude": {
              "$ref": "#/$defs/exclude"
            },
            "config": {
              "type": "string"
            },
            "discover_config": {
              "type": "boolean",
              "default": true
            },
            "extra_extensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\.[a-z][a-z0-9_]*$"
              }
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "includes": {
              "$ref": "#/$defs/exclude"
            },
            "baseline": {
              "type": "string"
            },
            "bootstrap_files": {
              "$ref": "#/$defs/exclude"
            },
            "scan_directories": {
              "$ref": "#/$defs/exclude"
            },
            "stub_files": {
              "$ref": "#/$defs/exclude"
            },
            "autoload": {
              "type": "string",
              "minLength": 1,
              "default": "auto"
            },
            "drupal": {
              "type": "boolean",
              "default": true
            },
            "strict_rules": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "all": {
                  "type": "boolean",
                  "default": true
                },
                "rules": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "disallowedLooseComparison": {
                      "type": "boolean"
                    },
                    "booleansInConditions": {
                      "type": "boolean"
                    },
                    "booleansInLoopConditions": {
                      "type": "boolean"
                    },
                    "uselessCast": {
                      "type": "boolean"
                    },
                    "requireParentConstructorCall": {
                      "type": "boolean"
                    },
                    "disallowedBacktick": {
                      "type": "boolean"
                    },
                    "disallowedEmpty": {
                      "type": "boolean"
                    },
                    "disallowedImplicitArrayCreation": {
                      "type": "boolean"
                    },
                    "disallowedShortTernary": {
                      "type": "boolean"
                    },
                    "overwriteVariablesWithLoop": {
                      "type": "boolean"
                    },
                    "closureUsesThis": {
                      "type": "boolean"
                    },
                    "matchingInheritedMethodNames": {
                      "type": "boolean"
                    },
                    "numericOperandsInArithmeticOperators": {
                      "type": "boolean"
                    },
                    "strictFunctionCalls": {
                      "type": "boolean"
                    },
                    "dynamicCallOnStaticMethod": {
                      "type": "boolean"
                    },
                    "switchConditionsMatchingType": {
                      "type": "boolean"
                    },
                    "noVariableVariables": {
                      "type": "boolean"
                    },
                    "strictArrayFilter": {
                      "type": "boolean"
                    },
                    "illegalConstructorMethodCall": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "deprecations": {
              "type": "boolean",
              "default": true
            },
            "memory_limit_mb": {
              "type": "integer",
              "minimum": 64,
              "maximum": 4096,
              "default": 512
            }
          }
        },
        "composer-validate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "fail_on": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "never"
              ],
              "default": "error"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 120
            },
            "include": {
              "$ref": "#/$defs/include"
            },
            "exclude": {
              "$ref": "#/$defs/exclude"
            },
            "strict": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "composer-audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "required": {
              "type": "boolean",
              "default": false
            },
            "fail_on": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "never"
              ],
              "default": "error"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 120
            },
            "no_dev": {
              "type": "boolean",
              "default": false
            },
            "abandoned": {
              "type": "string",
              "enum": [
                "report",
                "ignore"
              ],
              "default": "report"
            },
            "offline": {
              "type": "boolean",
              "default": false
            },
            "max_age_hours": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760,
              "default": 24
            },
            "max_stale_hours": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760,
              "default": 168
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "until": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              }
            }
          }
        },
        "twig-cs-fixer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoload": {"type": "string", "default": ""},
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "fail_on": {
              "type": "string",
